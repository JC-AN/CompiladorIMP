// Analizador léxico funcional para el IMP básico de Winskel.
// Conserva los nombres de token: serán la interfaz con el parser.

// Palabras reservadas de IMP. La prioridad evita que se clasifiquen como LOC.
TRUE.2: /true(?![A-Za-z0-9_])/
FALSE.2: /false(?![A-Za-z0-9_])/
SKIP.2: /skip(?![A-Za-z0-9_])/
IF.2: /if(?![A-Za-z0-9_])/
THEN.2: /then(?![A-Za-z0-9_])/
ELSE.2: /else(?![A-Za-z0-9_])/
WHILE.2: /while(?![A-Za-z0-9_])/
DO.2: /do(?![A-Za-z0-9_])/
INT.2: /int(?![A-Za-z0-9_])/
BOOL.2: /bool(?![A-Za-z0-9_])/
PRINT.2: /print(?![A-Za-z0-9_])/
FOR.2: /for(?![A-Za-z0-9_])/

// Datos de IMP.
NUM: /[0-9]+/
LOC: /[A-Za-z][A-Za-z0-9_]*/

// Operadores y delimitadores de IMP.
ASSIGN: ":="
LE: "<="
AND: "&&"
OR: "||"
PLUS: "+"
MINUS: "-"
TIMES: "*"
EQ: "="
NOT: "!"
SEMI: ";"
LPAR: "("
RPAR: ")"
COMMENT: /\/\/[^\n]*/
LBRACE: "{"
RBRACE: "}"
INC: "++"
DEC: "--"

// TODO 3: agrega INT, BOOL, PRINT y FOR como palabras reservadas.

// TODO 4: agrega LBRACE, RBRACE, INC y DEC.

%import common.WS
%ignore WS
%ignore COMMENT
